{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "keycloakctl non-secret configuration (version 1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "profile", "engine"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "profile": {"enum": ["dev", "ci", "readiness", "qualification"]},
    "engine": {"enum": ["podman", "docker"]},
    "remote": {
      "type": "object",
      "description": "Optional at setup; all operator inputs are required before remote preflight.",
      "additionalProperties": false,
      "properties": {
        "target_host": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*(?![\\s\\S])",
          "default": "ben-x260"
        },
        "target_dns_name": {
          "type": "string",
          "description": "Exact expected Tailscale Self.DNSName, without a trailing dot.",
          "maxLength": 253,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*(?![\\s\\S])"
        },
        "target_user": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,31}$"
        },
        "target_ip": {
          "type": "string",
          "pattern": "^100\\.(?:6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])(?:\\.(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])){2}(?![\\s\\S])"
        },
        "proxy_ip": {"$ref": "#/properties/remote/properties/target_ip"},
        "public_origin": {
          "type": "string",
          "maxLength": 267,
          "pattern": "^https://[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*\\.[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?![\\s\\S])"
        },
        "route_attested": {"type": "boolean"}
      }
    }
  },
  "if": {"properties": {"profile": {"enum": ["dev", "ci"]}}},
  "then": {"not": {"required": ["remote"]}}
}
